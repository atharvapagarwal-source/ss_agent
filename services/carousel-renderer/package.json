{
  "name": "carousel-renderer",
  "version": "1.0.0",
  "description": "Playwright-powered carousel rendering microservice for LinkedIn PDFs & Instagram PNGs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "install-browsers": "npx playwright install chromium --with-deps"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.47.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.5",
    "multer": "^1.4.5-lts.1",
    "@aws-sdk/client-s3": "^3.665.0",
    "@supabase/storage-js": "^2.7.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2",
    "ts-node-dev": "^2.0.0"
  }
}
