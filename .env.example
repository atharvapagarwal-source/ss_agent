# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=SocialCoach AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://socialcoach:socialcoach_dev@localhost:5432/socialcoach
DATABASE_URL_SYNC=postgresql://socialcoach:socialcoach_dev@localhost:5432/socialcoach
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from services.encryption import generate_new_vault_key; print(generate_new_vault_key())"
OAUTH_VAULT_ENCRYPTION_KEY=GENERATE_A_32_BYTE_BASE64_KEY_HERE

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_PRO_MODEL=gemini-2.0-pro

# ── Search APIs ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-api-key
NEWS_API_KEY=your-newsapi-key

# ── Meta (Instagram + Facebook) ───────────────────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-unique-webhook-verify-token

# ── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_WEBHOOK_VERIFY_TOKEN=your-linkedin-webhook-token

# ── Twitter/X ─────────────────────────────────────────────────────────────────
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ── Carousel Renderer ─────────────────────────────────────────────────────────
CAROUSEL_RENDERER_URL=http://localhost:3001

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
